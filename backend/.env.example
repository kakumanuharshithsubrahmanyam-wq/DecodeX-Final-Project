# RTGS backend — copy to .env (never commit real values)

APP_ENV=development

# Local-only auth bypass (NEVER enable in production)
# AUTH_DEV_BYPASS=true
# AUTH_DEV_USER_ID=00000000-0000-0000-0000-000000000001
APP_NAME=RTGS API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_for_local_verification
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_server_only
SUPABASE_ANON_KEY=your_anon_key_optional_for_client_simulation

# Database (Supabase Postgres — use pooler in production)
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# JWT validation (must match Supabase project)
JWT_AUDIENCE=authenticated
JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
JWT_ALGORITHMS=HS256,ES256,RS256
# Optional override; default is SUPABASE_URL/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_JWKS_URL=

# Storage (complaint evidence)
SUPABASE_STORAGE_BUCKET=complaint-attachments
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,application/pdf
SIGNED_URL_TTL_SECONDS=900

# AI pipeline: rules | llm | hybrid (rules always available as fallback)
AI_MODE=rules
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_REQUEST_TIMEOUT_SECONDS=25
# AI_VISION_PROVIDER=openai

# Reopen policy (days after resolution; not an official government rule)
REOPEN_WINDOW_DAYS=30

# Grievance reference ID prefix
GRIEVANCE_REF_PREFIX=RTGS

# Feature flags (optional)
FEATURE_WHATSAPP=false
FEATURE_VOICE_INTAKE=false
FEATURE_COMMUNITY=false

# Email (Next phase)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@example.com

# SMS / WhatsApp provider (Next/Future — e.g. Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Web push (Next)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
