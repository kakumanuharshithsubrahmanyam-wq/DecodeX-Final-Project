# RTGS frontend — copy to .env.local for Vite (never commit real values)

# FastAPI backend base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Supabase project (publishable / anon key only — never service role)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Optional: enable debug logging in development
VITE_APP_ENV=development

# UI preview with sample Hyderabad data only (no Supabase). Never enable in production.
# VITE_DEMO_MODE=true
