# Copy to .env.rtgs at repo root (gitignored). Never commit real values.
# Supabase → Project Settings → Database → Database password
RTGS_DB_PASSWORD=your_database_password
# Supabase → Project Settings → API → service_role (server only)
RTGS_SERVICE_ROLE_KEY=your_service_role_key
# Supabase → Project Settings → API → anon or publishable key (client)
RTGS_ANON_KEY=your_anon_or_publishable_key
# Optional legacy JWT secret (omit if backend uses JWKS via SUPABASE_URL)
# RTGS_JWT_SECRET=
RTGS_PROJECT_REF=fsnqpcomhtseoffwgfub
